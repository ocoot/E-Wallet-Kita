{
  "id": "/",
  "name": "E-Wallet Kita",
  "short_name": "EWK",
  "description": "Manage your personal finances: record transactions, set budgets, track bills & installments, and save — all in one app.",
  "lang": "en",
  "dir": "ltr",
  "start_url": "/dashboard",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone"],
  "orientation": "portrait-primary",
  "background_color": "#0A1512",
  "theme_color": "#3FBE9B",
  "categories": ["finance", "productivity", "utilities"],
  "share_target": {
    "action": "/share-target",
    "method": "POST",
    "enctype": "multipart/form-data",
    "params": {
      "files": [{ "name": "receipt", "accept": ["image/*"] }]
    }
  },
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/logo.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "shortcuts": [
    {
      "name": "Add Transaction",
      "short_name": "Transaction",
      "description": "Record a new transaction directly",
      "url": "/transactions/new",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Transaction History",
      "short_name": "History",
      "description": "View all transaction history",
      "url": "/transactions",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Wallets",
      "short_name": "Wallets",
      "description": "Manage your balance and wallets",
      "url": "/wallets",
      "icons": [{ "src": "/icon-192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "screenshots": [
    {
      "src": "/screenshot-home.png",
      "sizes": "1280x900",
      "type": "image/png",
      "form_factor": "wide",
      "label": "E-Wallet Kita Dashboard"
    },
    {
      "src": "/screenshot-mobile-home.png",
      "sizes": "1080x2340",
      "type": "image/png",
      "form_factor": "narrow",
      "label": "E-Wallet Kita Dashboard (Mobile)"
    }
  ]
}
