# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# VITE_SUPABASE_URL: URL of your Supabase project (for production)
VITE_SUPABASE_URL="https://your-project.supabase.co"

# VITE_SUPABASE_ANON_KEY: Anon public key of your Supabase project (for production)
VITE_SUPABASE_ANON_KEY="your-anon-key"

# Gmail SMTP Configuration for sending receipts
SMTP_EMAIL="your-email@gmail.com"
SMTP_PASSWORD="your-google-app-password"

# TELEGRAM_BOT_TOKEN: Bot token provided by @BotFather (for Phase 2 Bot integration)
TELEGRAM_BOT_TOKEN="your-telegram-bot-token"

# TELEGRAM_WEBHOOK_SECRET: Secret token to protect your webhook endpoint (X-Telegram-Bot-Api-Secret-Token)
TELEGRAM_WEBHOOK_SECRET="your-secure-webhook-secret-token"

# KLIKQRIS_API_KEY / KLIKQRIS_MERCHANT_ID: untuk fitur Premium QRIS.
# WAJIB diisi di Vercel Project Settings > Environment Variables (server-side only, JANGAN di VITE_*).
KLIKQRIS_API_KEY="your-klikqris-api-key"
KLIKQRIS_MERCHANT_ID="your-klikqris-merchant-id"

# SUPABASE_URL / SUPABASE_SERVICE_ROLE_KEY: dipakai server (api/*) untuk akses admin ke Supabase.
SUPABASE_URL="https://your-project.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="your-service-role-key"

# --- Support Chat Widget (bot Telegram KEDUA, terpisah dari TELEGRAM_BOT_TOKEN) ---
# Disetel sebagai Supabase Edge Function secrets (`supabase secrets set ...`),
# BUKAN di Vercel env, karena dipakai oleh supabase/functions/support-bridge.
# SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY, SUPABASE_ANON_KEY juga perlu di-set
# sebagai Edge Function secrets (Supabase biasanya sudah inject otomatis untuk
# SUPABASE_URL/SUPABASE_ANON_KEY/SUPABASE_SERVICE_ROLE_KEY, cek dulu sebelum set manual).
SUPPORT_TELEGRAM_BOT_TOKEN="your-second-telegram-bot-token"
SUPPORT_TELEGRAM_WEBHOOK_SECRET="your-secure-webhook-secret-token"

# AI Provider Keys
GEMINI_API_KEY_1="your-gemini-api-key-1"
GEMINI_API_KEY_2="your-gemini-api-key-2"
GEMINI_API_KEY_3="your-gemini-api-key-3"
GEMINI_API_KEY_4="your-gemini-api-key-4"

OPENAI_API_KEY_1="your-openai-api-key-1"
OPENAI_API_KEY_2="your-openai-api-key-2"
OPENAI_API_KEY_3="your-openai-api-key-3"
OPENAI_API_KEY_4="your-openai-api-key-4"

ANTHROPIC_API_KEY_1="your-anthropic-api-key-1"
ANTHROPIC_API_KEY_2="your-anthropic-api-key-2"
ANTHROPIC_API_KEY_3="your-anthropic-api-key-3"
ANTHROPIC_API_KEY_4="your-anthropic-api-key-4"

# ── Firebase Cloud Messaging (Push Notifications) ─────────────────────
VITE_FIREBASE_API_KEY="your-firebase-api-key"
VITE_FIREBASE_AUTH_DOMAIN="your-project.firebaseapp.com"
VITE_FIREBASE_PROJECT_ID="your-project-id"
VITE_FIREBASE_MESSAGING_SENDER_ID="your-sender-id"
VITE_FIREBASE_APP_ID="your-firebase-app-id"
VITE_FIREBASE_VAPID_KEY="your-vapid-public-key"

# Server-side credentials for Firebase Admin SDK (api/*)
FIREBASE_PROJECT_ID="your-project-id"
FIREBASE_CLIENT_EMAIL="firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com"
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_KEY\n-----END PRIVATE KEY-----"
